rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // The app currently uploads images via Cloudinary. Firebase Storage is locked
    // down to authenticated, owner-scoped paths so nothing can be read or written
    // outside a user's own folder.
    match /uploads/{uid}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Deny everything else.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
